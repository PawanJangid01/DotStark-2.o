@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.ImplementAiBlogDetails>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "MasterLayout.cshtml";
}


@section Styles {
<style>
    .blog-banner { background: linear-gradient(135deg, #f0f4ff 0%, #e8eeff 100%); border-bottom: 1px solid var(--border); padding: 4rem 0 0; text-align: center; }
    .blog-banner-meta { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; display: flex; align-items: center; justify-content: center; gap: 1rem; }
    .blog-banner-meta .tag { background: var(--primary-10); color: var(--primary); font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 2rem; }
    .blog-banner h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); color: var(--foreground); max-width: 820px; margin: 0 auto 2.5rem; line-height: 1.2; }

        .blog-banner-img {
            width: 100%;
            max-height: 420px;
            object-fit: cover;
            display: block;
            min-height: 100%;
        }
    .blog-page { padding: 2rem 0 0; background: var(--background); }

        .blog-layout {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 3.5rem;
            align-items: start;
            padding-bottom: 5rem;
        }
    .blog-sidebar { position: sticky; top: 5rem; }
    .toc-box { background: var(--cool-grey); border-radius: 0.75rem; padding: 1.5rem; border: 1px solid var(--border); margin-bottom: 1.5rem; }
    .toc-box > span { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 1rem; font-weight: 600; }
    .toc-box ul { list-style: none; display: flex; flex-direction: column; gap: 0; }
    .toc-box ul li a { display: block; padding: 0.3rem 0.5rem 0.3rem 0.75rem; font-size: 0.8rem; color: var(--muted); border-left: 2px solid var(--border); line-height: 1.4; transition: color 0.2s, border-color 0.2s; }
    .toc-box ul li a:hover, .toc-box ul li a.active { color: var(--primary); border-left-color: var(--primary); }
    .blog-body { min-width: 0; }
    .blog-body p { font-size: 0.9375rem; color: #737373; line-height: 1.85; margin-bottom: 1.1rem; }
    .blog-body h2 { font-size: 1.4rem; color: var(--foreground); margin: 2.5rem 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--primary-10); scroll-margin-top: 5rem; font-family: var(--font-heading); }
    .blog-body h3 { font-size: 1.1rem; color: var(--foreground); margin: 1.75rem 0 0.5rem; scroll-margin-top: 5rem; font-family: var(--font-heading); }
    .blog-body ul, .blog-body ol { list-style: none; margin: 0.5rem 0 1.25rem; display: flex; flex-direction: column; gap: 0.45rem; }
    .blog-body ul li, .blog-body ol li {  align-items: flex-start; gap: 0.6rem; font-size: 0.9375rem; color: #737373; line-height: 1.7; }
    .blog-body ul li::before { content: ''; flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: #353535; margin-top: 0.58rem; }
    .blog-body ol { counter-reset: ol-counter; }
    .blog-body ol li::before { content: counter(ol-counter); counter-increment: ol-counter; flex-shrink: 0; width: 1.4rem; height: 1.4rem; background: var(--primary); color: #fff; border-radius: 50%; font-size: 0.7rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-top: 0.15rem; }
    .blog-body strong { color: var(--foreground); }
    .blog-inline-img { width: auto;  border-radius: 0.75rem; margin: 1.5rem 0; object-fit: cover; max-height: 380px; border: 1px solid var(--border); }
    .flow-steps { display: flex; flex-direction: column; gap: 0.5rem; margin: 1rem 0 1.5rem; }
    .flow-step { display: flex; align-items: center; gap: 1rem; background: #f0f4ff; border: 1px solid rgba(27,84,255,0.12); border-radius: 0.5rem; padding: 0.75rem 1rem; font-size: 0.9rem; color: var(--foreground); }
    .flow-step .step-num { background: var(--primary); color: #fff; width: 1.75rem; height: 1.75rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; }
    @@media (max-width: 960px) { .blog-layout { grid-template-columns: 1fr; } .blog-sidebar {display:none; } }

    /* IMAGE CTA */
.image-cta {
    display: block;
    margin: 1.5rem 0;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.image-cta img {
    width: 100%;
    display: block;
}

.image-cta:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
}

.cs-banner { position: relative; width: 100%; height: 480px; overflow: hidden; }

    @@media (max-width: 1400px) {
            .cs-banner{ height:380px;}
    }
        .cs-banner-img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .cs-banner-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.55) 55%, rgba(0,0,0,0.15) 100%); }
        .cs-banner-content { position: absolute; bottom: 2.75rem; left: 50%; transform: translateX(-50%); width: 100%; }
        .cs-tag { display: inline-block; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: #fff; font-size: 0.72rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.875rem; backdrop-filter: blur(4px); }
        .cs-banner-title { font-size: clamp(1.4rem, 2.5vw, 2.25rem); font-weight: 700; color: #fff; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 0.75rem; font-family: var(--font-heading); }
        .cs-banner-sub { font-size: 1rem; color: rgba(255,255,255,0.8); line-height: 1.65; margin: 0; max-width: 560px; }
        @@media (max-width: 600px) { .cs-banner { height: 360px; } .cs-banner-content { bottom: 1.75rem; padding: 0 32px; } }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 380px));
            justify-content: center;
            gap: 32px;
        }

        @@media (max-width: 900px) {
            .cards-grid {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            overflow: hidden;
            transition: box-shadow 0.3s, border-color 0.3s;
        }

            .card:hover {
