@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.BlogLandingPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "MasterLayout.cshtml";
}

@section Styles {
  <style>
    :root {
      --ds-primary: #0040FF;
      --ds-dark: #0f172a;
      --ds-bg: #ffffff;
      --ds-secondary: #f1f5f9;
      --ds-border: #e2e8f0;
      --ds-muted: #64748b;
      --ds-card: #ffffff;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--ds-bg);
      color: var(--ds-dark);
      line-height: 1.6;
    }

    a { text-decoration: none; color: inherit; }
    img { display: block; max-width: 100%; }

    .container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }

    /* ── Hero ── */
    .hero {
      position: relative; padding: 18rem 3rem; text-align: center; overflow: hidden;
    }
    .hero-circles {
      position: absolute; top: 40px; right: 0; width: 400px; height: 400px; opacity: 0.05;
    }
    .hero-circles div {
      position: absolute; border-radius: 50%; border: 2px solid var(--ds-primary);
    }
    .hero-circles .c1 { inset: 0; }
    .hero-circles .c2 { inset: 48px; }
    .hero-circles .c3 { inset: 96px; }

    @@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
    .hero h1 { font-size: clamp(2.25rem, 5vw, 3.75rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 20px; }
    .hero h1 .accent { color: var(--ds-primary); }
    .hero p { font-size: 18px; color: var(--ds-muted); max-width: 640px; margin: 0 auto; }

    /* ── Section Commons ── */
    .section { padding: 10rem 0 5rem; }
    .hero { padding: 10rem 0 5rem; }
    .section.alt { background: #ffffff; }
    .section-label {
      font-size: 12px; font-weight: 700; color: var(--ds-primary);
      text-transform: uppercase; letter-spacing: 3px; margin-bottom: 12px;
    }
    .section-title { font-size: clamp(2.25rem, 5vw, 3.75rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px; }
    .section-desc { font-size: 16px; color: var(--ds-muted); max-width: 640px; margin: 0 auto 56px; }
    .section-header { text-align: center; margin-bottom: 56px; }

    /* ── Cards Grid ── */
    .cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
    @@media (max-width: 900px) { .cards-grid { grid-template-columns: 1fr; } }

    .card {
      background: var(--ds-card); border-radius: 16px; border: 1px solid var(--ds-border);
      overflow: hidden; transition: box-shadow 0.3s, border-color 0.3s;
    }
    .card:hover { box-shadow: 0 20px 40px rgba(0,0,0,0.08); border-color: rgba(0,64,255,0.3); }
    .card-img { position: relative; height: 210px; overflow: hidden; }
    .card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
    .card:hover .card-img img { transform: scale(1.05); }
    .card-tag {
      position: absolute; top: 16px; left: 16px;
      background: var(--ds-primary); color: #fff; font-size: 12px; font-weight: 600;
      padding: 4px 12px; border-radius: 50px;
    }
    .card-body { padding: 24px; }
    .card-body h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; line-height: 1.4; transition: color 0.2s; }
    .card:hover .card-body h3 { color: var(--ds-primary); }
    .card-body p { font-size: 14px; color: var(--ds-muted); line-height: 1.7; margin-bottom: 14px; }
    .card-meta { display: flex; align-items: center; gap: 16px; font-size: 12px; color: var(--ds-muted); margin-bottom: 12px; }
    .card-meta svg { width: 12px; height: 12px; }
    .card-author { display: flex; align-items: center; gap: 8px; padding-top: 8px; }
    .card-author .avatar {
      width: 28px; height: 28px; border-radius: 50%; background: rgba(0,64,255,0.1);
      display: flex; align-items: center; justify-content: center;
          color: #78748b;
          font-weight: bold;
    }
    .card-author .avatar svg { width: 14px; height: 14px; color: var(--ds-primary); }
    .card-author span { font-size: 12px; font-weight: 500; color: var(--ds-muted); }

    .read-link {
      display: inline-flex; align-items: center; gap: 8px;
      color: var(--ds-primary); font-size: 14px; font-weight: 600; transition: gap 0.2s;
    }
    .read-link:hover { gap: 12px; }
    .read-link svg { width: 14px; height: 14px; }

    /* ── Load More ── */
    .load-more-wrap { text-align: center; margin-top: 48px; }
    .btn-outline {
      display: inline-flex; align-items: center; gap: 8px;
      border: 1px solid var(--ds-border); background: transparent; color: var(--ds-dark);
      padding: 14px 32px; border-radius: 50px; font-size: 14px; font-weight: 600;
      cursor: pointer; transition: all 0.2s;
    }
    .btn-outline:hover { background: var(--ds-card); border-color: rgba(0,64,255,0.3); }
    .btn-outline svg { width: 14px; height: 14px; }

    /* ── Stats ── */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
    @@media (max-width: 768px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }

        @@media (max-width: 460px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    .stat-card {
      background: var(--ds-card); border: 1px solid var(--ds-border); border-radius: 12px;
      padding: 32px; text-align: center; transition: all 0.3s;
    }
    .stat-card:hover { border-color: rgba(0,64,255,0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.06); }
    .stat-card .value { font-size: clamp(28px, 3vw, 40px); font-weight: 800; color: var(--ds-primary); margin-bottom: 8px; }
    .stat-card .label { font-size: 14px; color: var(--ds-muted); font-weight: 500; }


    /* ══════════════════════════════════════════════
   10. CTA
   ══════════════════════════════════════════════ */
.cta-section {
    background: var(--primary);
    text-align: center;
}

    .cta-section .inner {
        max-width: 48rem;
        margin: 0 auto;
    }

    .cta-section h2 {
        font-size: clamp(1.875rem, 4vw, 3rem);
        font-weight: 700;
        color: #fff;
        margin-bottom: 1.5rem;
        line-height: 1.15;
    }

    .cta-section p {
        font-size: 1.125rem;
        font-family: var(--font-body);
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 2.5rem;
        line-height: 1.7;
    }

    .cta-section .btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
    }

    .case-card { overflow: hidden; max-width: 760px; margin: 0 auto; }
    .case-bar { height: 8px; background: linear-gradient(90deg, var(--primary), var(--primary-60)); }
    .case-body { padding: 2rem 3rem; }
    .case-body h3 { font-size: 1.5rem; font-weight: 600; margin: 1rem 0; }
    .case-body p { color: var(--muted); line-height: 1.7; margin-bottom: 2rem; }

.cards-grid .read-link {
  display: inline-block;
  color: var(--ds-primary);
  font-size: 14px;
  font-weight: 600;
  transition: transform 0.3s ease, color 0.3s ease;
}

.cards-grid .read-link:hover {
  transform: translateY(-3px);
}

h1 span {
  color: var(--ds-primary);
}

.card-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

/* VERY IMPORTANT */
.card-link .card {
  height: 100%;
}

/* Keep your original hover */
.card:hover {
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  border-color: rgba(0,64,255,0.3);
}


        .resources-section{
            padding-top:5rem;
        }
       

        .Resource-header {
            text-align: center;
            margin-bottom: 3rem;
        }

            .Resource-header h2 {
                font-family: var(--font-heading);
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 1rem;
            }

            .Resource-header p {
                color: var(--muted);
                font-size: 1.1rem;
            }

        /* Grid Layout */
        .resources-section .resource-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(480px, 480px));
            gap: 1.5rem;
            justify-content: center;
        }

        /* Resource Card */
        .resources-section .resource-card {
            background: rgba(27, 84, 255, 0.1);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.5rem;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

            .resources-section .resource-card:hover {
                border-color: var(--primary);
                box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            }

        .resources-section .icon {
            width: 48px;
            height: 48px;
            background: #1b54ff;
            border-radius: calc(var(--radius) - 2px);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
            font-size: 1.5rem;
        }

        .resources-section .resource-card h3 {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
        }

        .resources-section .resource-card p {
            color: var(--muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            flex-grow: 1;
        }

        .resources-section .btn-download {
            background: #1b54ff;
            color: white;
            border: none;
            padding: 0.75rem 1rem;
            border-radius: var(--radius);
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
        }

            .resources-section .btn-download:hover {
                background: var(--primary);
            }

        /* Form Styling */
        .resources-section .form-container {
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
            opacity: 0;
        }

            .resources-section .form-container.active {
                max-height: 200px;
                opacity: 1;
                margin-top: 1.5rem;
                padding-top: 1.5rem;
                border-top: 1px solid var(--border);
            }

        .resources-section .email-form {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .resources-section .input-group {
            position: relative;
        }

        .resources-section input[type="email"] {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            font-family: var(--font-body);
            outline: none;
            transition: var(--transition);
        }

            .resources-section input[type="email"]:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(27, 84, 255, 0.1);
            }

        .resources-section .btn-submit {
            background: black;
            color: white;
            border: none;
            padding: 0.75rem;
            border-radius: var(--radius);
            font-weight: 600;
            cursor: pointer;
        }

        /* Messages */
        .resources-section .message {
            font-size: 0.85rem;
            margin-top: 0.5rem;
            display: none;
        }

        .resources-section .error-message {
            color: #dc2626;
        }

        .resources-section .success-message {
            color: #059669;
            font-weight: 500;
        }

        @@media (max-width: 640px) {
            .resources-section .resource-grid {
            grid-template-columns: 1fr;
        }

        }


  </style>
}



