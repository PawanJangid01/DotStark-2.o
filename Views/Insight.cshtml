 <script>
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.resource-card');
        
        // List of blocked personal domains
        const blockedDomains = [
            'gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 
            'icloud.com', 'aol.com', 'protonmail.com', 'mail.com'
        ];

        cards.forEach(card => {
            const downloadBtn = card.querySelector('.btn-download');
            const formContainer = card.querySelector('.form-container');
            const form = card.querySelector('.email-form');
            const emailInput = card.querySelector('input[type="email"]');
            const errorMsg = card.querySelector('.error-message');
            const successMsg = card.querySelector('.success-message');
            const resourceId = card.getAttribute('data-resource-id');

            // 1. Handle Toggle logic
            downloadBtn.addEventListener('click', (e) => {
                const isActive = formContainer.classList.contains('active');
                
                // Close all other open forms first
                document.querySelectorAll('.form-container').forEach(container => {
                    container.classList.remove('active');
                });

                // Toggle this one
                if (!isActive) {
                    formContainer.classList.add('active');
                    emailInput.focus();
                }
            });

            // 2. Form Submission & Validation
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const emailValue = emailInput.value.trim().toLowerCase();
                const domain = emailValue.split('@@')[1];

                // Reset states
                errorMsg.style.display = 'none';
                successMsg.style.display = 'none';

                // Basic format check + Work email check
                if (!emailValue.includes('@@') || blockedDomains.includes(domain)) {
                    errorMsg.textContent = blockedDomains.includes(domain) 
                        ? "Please use a business email. Personal domains are not allowed." 
                        : "Please enter a valid email address.";
                    errorMsg.style.display = 'block';
                    return;
                }

                // Prepare Data
