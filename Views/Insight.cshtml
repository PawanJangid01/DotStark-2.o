    .case-card { overflow: hidden; max-width: 760px; margin: 0 auto; }
    .case-bar { height: 8px; background: linear-gradient(90deg, var(--primary), var(--primary-60)); }
    .case-body { padding: 2rem 3rem; }
    .case-body h3 { font-size: 1.5rem; font-weight: 600; margin: 1rem 0; }
    .case-body p { color: var(--muted); line-height: 1.7; margin-bottom: 2rem; }

.cards-grid .read-link {
  display: inline-block;
  color: var(--ds-primary);
  font-size: 14px;
  font-weight: 600;
  transition: transform 0.3s ease, color 0.3s ease;
}

.cards-grid .read-link:hover {
  transform: translateY(-3px);
}

h1 span {
  color: var(--ds-primary);
}

.card-link {
  display: block;
  text-decoration: none;
  color: inherit;
}

/* VERY IMPORTANT */
.card-link .card {
  height: 100%;
}

/* Keep your original hover */
.card:hover {
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  border-color: rgba(0,64,255,0.3);
}


        .resources-section{
