        .Resource-header {
            text-align: center;
            margin-bottom: 3rem;
        }

            .Resource-header h2 {
                font-family: var(--font-heading);
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 1rem;
            }

            .Resource-header p {
                color: var(--muted);
                font-size: 1.1rem;
            }

        /* Grid Layout */
        .resources-section .resource-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.5rem;
        }

        /* Resource Card */
        .resources-section .resource-card {
            background: rgba(27, 84, 255, 0.1);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.5rem;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

            .resources-section .resource-card:hover {
                border-color: var(--primary);
                box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            }

        .resources-section .icon {
            width: 48px;
            height: 48px;
            background: #1b54ff;
            border-radius: calc(var(--radius) - 2px);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
            font-size: 1.5rem;
        }

        .resources-section .resource-card h3 {
            font-family: var(--font-heading);
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
        }

        .resources-section .resource-card p {
            color: var(--muted);
            font-size: 0.95rem;
            margin-bottom: 1.5rem;
            flex-grow: 1;
        }

        .resources-section .btn-download {
            background: #1b54ff;
            color: white;
            border: none;
            padding: 0.75rem 1rem;
            border-radius: var(--radius);
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
        }

            .resources-section .btn-download:hover {
                background: var(--primary);
            }

        /* Form Styling */
        .resources-section .form-container {
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
            opacity: 0;
        }

            .resources-section .form-container.active {
                max-height: 200px;
                opacity: 1;
                margin-top: 1.5rem;
                padding-top: 1.5rem;
                border-top: 1px solid var(--border);
            }

        .resources-section .email-form {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .resources-section .input-group {
            position: relative;
        }

        .resources-section input[type="email"] {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            font-family: var(--font-body);
            outline: none;
            transition: var(--transition);
        }

            .resources-section input[type="email"]:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(27, 84, 255, 0.1);
            }

        .resources-section .btn-submit {
            background: black;
            color: white;
            border: none;
            padding: 0.75rem;
            border-radius: var(--radius);
            font-weight: 600;
            cursor: pointer;
        }

        /* Messages */
        .resources-section .message {
            font-size: 0.85rem;
            margin-top: 0.5rem;
            display: none;
        }

        .resources-section .error-message {
            color: #dc2626;
        }

        .resources-section .success-message {
            color: #059669;
            font-weight: 500;
        }

        @@media (max-width: 640px) {
            .resources-section .resource-grid {
            grid-template-columns: 1fr;
        }

        }


  </style>
}

