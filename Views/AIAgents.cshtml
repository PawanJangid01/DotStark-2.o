.agents-grid{display:grid;gap:24px}
@@media(min-width:992px){.agents-grid{grid-template-columns:repeat(3,1fr);align-items:stretch}}

        .agent-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 32px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column
        }

        .agent-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px -5px rgba(0, 0, 0, 0.08);
        }

        .agent-card:before {
            content: "";
            position: absolute;
            inset: 0;
            padding: 1px; /* border thickness */
            border-radius: 0.5rem;
            --angle: 270deg;
            background: conic-gradient( from var(--angle), transparent 0deg, transparent 300deg, var(--primary) 330deg, transparent 360deg );
            z-index: 0;
            opacity: 0;
            pointer-events: none;
            /* Keep only border */
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
        }

        @@property --angle {
            syntax: "<angle>";
            inherits: false;
            initial-value: 270deg;
        }

        .agent-card::after {
            content: "";
            position: absolute;
            inset: 2px;
            /* background: #fff; */
            border-radius: 0.5rem;
            z-index: 0;
        }

        .agent-card > * {
            position: relative;
            z-index: 2;
        }

        .agent-card:hover::before {
            opacity: 1;
            animation: snake-border 3.2s linear infinite;
        }

        @@keyframes snake-border {
            from {
                --angle: 270deg;
            }

            to {
                --angle: 630deg;
            }
        }
.agent-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;margin-bottom:24px;color:var(--primary)}
.agent-icon svg{width:24px;height:24px;stroke:var(--primary);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.agent-card h3{font-size:1.25rem;font-weight:700;margin-bottom:12px}
.agent-body{flex:1;display:flex;flex-direction:column}
.agent-card .desc{color:var(--text-dim);margin-bottom:16px}
.agent-card .detail{font-size:0.875rem;color:var(--text-muted);margin-bottom:24px}
.cap-label{font-size:0.875rem;font-weight:600;margin-bottom:12px;padding-top:24px}
.cap-list{list-style:none;display:flex;flex-direction:column;gap:8px}
