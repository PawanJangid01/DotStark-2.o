.hero h1 span{background:hsl(228, 100%, 55%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero .lead{font-size:clamp(1.125rem, 2vw, 1.25rem);color:var(--text-dim);max-width:800px;margin:0 auto 16px}
.hero .sublead{font-size:1rem;color:var(--text-muted);max-width:800px;margin:0 auto 40px}

        @@media (min-width: 1024px) {
